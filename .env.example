# Quran Foundation Content API (api.quran.foundation) OAuth2 client credentials.
# Sign up at their developer portal to get these. Never commit the real .env file.
QF_CLIENT_ID=
QF_CLIENT_SECRET=

# "prelive" (default, for development) or "production". New developer apps
# start in prelive; only switch once production access has been approved.
QF_ENV=prelive

# Signs the login session cookie (see docs/adr/0002-user-accounts.md). Any
# long random string; generate one with `python -c "import secrets; print(secrets.token_hex(32))"`.
# Never commit the real value, and don't rotate it in production -- rotating
# invalidates every existing logged-in session. REQUIRED in production; a
# throwaway default is used only for local `uvicorn app.main:app`.
SESSION_SECRET_KEY=

# --- Web app (optional; sensible defaults for local dev) ---
# Where the SQLite DB, reference bundles, and uploaded recordings live.
# On Railway/Render, point SADA_DATA_DIR at a mounted volume so the DB and
# attempt history survive redeploys.
# SADA_DATA_DIR=/data
# SADA_DATABASE_URL=sqlite:////data/sada.db
# SADA_RETAIN_AUDIO=1          # set to 0 to discard uploads after scoring
# SADA_MAX_UPLOAD_BYTES=15728640

# Only needed if ffmpeg isn't on PATH (it is in the Railway/Render build).
# FFMPEG_BINARY=/usr/bin/ffmpeg
