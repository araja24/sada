# Quran Foundation Content API (api.quran.foundation) OAuth2 client credentials.
# Sign up at their developer portal to get these. Never commit the real .env file.
QF_CLIENT_ID=
QF_CLIENT_SECRET=

# "prelive" (default, for development) or "production". New developer apps
# start in prelive; only switch once production access has been approved.
QF_ENV=prelive

# Signs the login session cookie (see docs/adr/0002-user-accounts.md). Any
# long random string; generate one with `python -c "import secrets; print(secrets.token_hex(32))"`.
# Never commit the real value, and don't rotate it in production -- rotating
# invalidates every existing logged-in session.
SESSION_SECRET_KEY=
