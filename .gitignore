# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Secrets
.env

# User-uploaded recitations and the attempts DB — regenerable/private, never committed
data/attempts/*
!data/attempts/.gitkeep
*.db

# Precomputed reference features — regenerable via scripts/build_reference.py
data/reference/*
!data/reference/.gitkeep

# Node / Vite. dist/ is deliberately NOT ignored: Render's python runtime has
# no Node, so the build output is committed (see ADR-0003).
frontend/node_modules/

# OS
.DS_Store
Thumbs.db
